<Page
    x:Class="BeamMPTools.App.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:BeamMPTools.Core.Models">

    <Grid Margin="24" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="BeamMP Tools" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock
                    Text="BeamNG.drive 与 BeamMP 桌面工具箱"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource BodyTextBlockStyle}" />
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="4">
                <TextBlock Text="本软件使用GPL3.0许可证" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" />
                <TextBlock Text="我们的价值体系是为了全体中文BeamMP玩家服务" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16">
                <Border
                    Padding="18"
                    CornerRadius="12"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="14">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="环境检测" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock Text="自动定位游戏、客户端与资源目录。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                Content="重新检测"
                                Command="{Binding DetectCommand}"
                                VerticalAlignment="Center" />
                        </Grid>

                        <Grid ColumnSpacing="12" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border
                                Grid.Row="0"
                                Grid.Column="0"
                                Padding="14"
                                CornerRadius="8"
                                Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="BeamNG.drive" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding BeamNGStatus}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{Binding BeamNGPath}" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Border>

                            <Border
                                Grid.Row="0"
                                Grid.Column="1"
                                Padding="14"
                                CornerRadius="8"
                                Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="BeamMP Launcher" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding BeamMPStatus}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{Binding BeamMPPath}" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Border>

                            <Border
                                Grid.Row="1"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Padding="14"
                                CornerRadius="8"
                                Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="BeamMP Resources" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ResourcesStatus}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{Binding ResourcesPath}" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border
                    Padding="18"
                    CornerRadius="12"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="快捷操作" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock
                            Text="所有在工具箱启动的BeamNG/BeamMP均通过Steam记录BeamNG游戏时长，但在游戏期间请勿关闭此程序！"
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <Grid ColumnSpacing="10" RowSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Button Grid.Row="0" Grid.Column="0" Content="启动 BeamNG" Command="{Binding LaunchBeamNGCommand}" HorizontalAlignment="Stretch" />
                            <Button Grid.Row="0" Grid.Column="1" Content="启动 BeamMP" Command="{Binding LaunchBeamMPCommand}" HorizontalAlignment="Stretch" />
                            <Button Grid.Row="1" Grid.Column="0" x:Name="InstallButton" Content="安装 / 更新 BeamMP" Click="InstallButton_Click" HorizontalAlignment="Stretch" IsEnabled="{Binding IsNotBusy}" />
                            <Button Grid.Row="1" Grid.Column="1" Content="打开 Resources 文件夹" Command="{Binding OpenResourcesCommand}" HorizontalAlignment="Stretch" />
                            <Button Grid.Row="2" Grid.Column="0" Content="验证 Steam 游戏文件" Command="{Binding ValidateSteamCommand}" HorizontalAlignment="Stretch" />
                            <Button Grid.Row="2" Grid.Column="1" Content="打开 BeamMP 中文文档" Command="{Binding OpenDocsCommand}" HorizontalAlignment="Stretch" />
                        </Grid>
                    </StackPanel>
                </Border>
                <Border
    Padding="18"
    CornerRadius="12"
    BorderThickness="1"
    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

                    <StackPanel Spacing="10">
                        <TextBlock
            Text="BeamMP 安装位置"
            Style="{StaticResource SubtitleTextBlockStyle}" />

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox
                Grid.Column="0"
                Text="{Binding BeamMPInstallPath, Mode=OneWay}"
                IsReadOnly="True"
                PlaceholderText="自动检测安装目录"
                VerticalAlignment="Center" />

                            <Button
                Grid.Column="1"
                Content="浏览..."
                Click="ChooseBeamMPInstallPath_Click" />

                            <Button
                Grid.Column="2"
                Content="自动检测"
                Click="ResetBeamMPInstallPath_Click" />
                        </Grid>

                        <TextBlock
            Text="可以手动指定已经安装的 BeamMP Launcher 所在目录。以防自动检测出现问题。"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            FontSize="12" />
                    </StackPanel>
                </Border>
                <Border
                    Padding="18"
                    CornerRadius="12"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="10">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="运行日志" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock Text="日志保存至本地 AppData，可进行快速反馈" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="清空显示" Command="{Binding ClearLogsCommand}" VerticalAlignment="Center" />
                        </Grid>
                        <ListView
                            ItemsSource="{Binding LogEntries}"
                            MaxHeight="260"
                            SelectionMode="None"
                            IsItemClickEnabled="False">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:LogEntry">
                                    <TextBlock
                                        Text="{x:Bind DisplayText}"
                                        FontFamily="Consolas"
                                        FontSize="12"
                                        TextWrapping="Wrap"
                                        Padding="2,3" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Text="{Binding BusyText}"
                        MinHeight="20"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <Button
                        Grid.Column="1"
                        Content="取消当前操作"
                        Command="{Binding CancelCommand}"
                        IsEnabled="{Binding CanCancel}" />
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
